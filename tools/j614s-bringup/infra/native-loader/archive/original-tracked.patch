-    if (usb_shutdown_failed || dev->failed || dev->dma_unsafe)
+    if (usb_shutdown_failed || dev->failed || dev->dma_unsafe) {
+        NATIVE_USB_STEP(dev, "BAD_STATE");
@@ -1902,0 +1973,11 @@ bool usb_dwc3_shutdown(dwc3_dev_t *dev)
+    }
