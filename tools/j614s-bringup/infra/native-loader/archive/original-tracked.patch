diff --git c/src/usb_dwc3.c w/src/usb_dwc3.c
index f0e7829..a8e2ea5 100644
--- c/src/usb_dwc3.c
+++ w/src/usb_dwc3.c
@@ -29,0 +30,3 @@
+#ifdef J614S_NATIVE
+#include "j614s_native.h"
+#endif
@@ -179,0 +183,17 @@ typedef struct dwc3_dev {
+#ifdef J614S_NATIVE
+/* [DEBUG-J614S-NATIVE] Direct display diagnostics survive a USB shutdown fault. */
+static void native_usb_step(dwc3_dev_t *dev, const char *phase)
+{
+    unsigned port = 9;
+    if (dev->regs >= 0x382280000UL && dev->regs <= 0x392280000UL &&
+        !((dev->regs - 0x382280000UL) % 0x8000000UL))
+        port = (dev->regs - 0x382280000UL) / 0x8000000UL;
+    char text[24];
+    snprintf(text, sizeof(text), "USB%u_%s", port, phase);
+    j614s_native_note(text);
+}
+#define NATIVE_USB_STEP(dev, phase) native_usb_step(dev, phase)
+#else
+#define NATIVE_USB_STEP(dev, phase) do { } while (0)
+#endif
+
@@ -1896,0 +1917,49 @@ bool usb_dwc3_shutdown_failed(void)
+#ifdef J614S_NATIVE
+static int usb_dwc3_quiet_control(dwc3_dev_t *dev)
+{
+    u64 deadline = timeout_calculate(2000000), quiet_deadline = 0;
+    do {
+        u32 count = read32(dev->regs + DWC3_GEVNTCOUNT(0)) & DWC3_GEVNTCOUNT_MASK;
+        if (count > DWC3_EVENT_BUFFERS_SIZE || count % sizeof(union dwc3_event))
+            return -1;
+        usb_dwc3_handle_events(dev);
+        if (dev->failed || dev->dma_unsafe)
+            return -1;
+        bool setup = dev->ep0_state == USB_DWC3_EP0_STATE_SETUP_HANDLE ||
+                     (dev->ep0_state == USB_DWC3_EP0_STATE_IDLE &&
+                      !dev->endpoints[USB_LEP_CTRL_OUT].xfer_in_progress);
+        count = read32(dev->regs + DWC3_GEVNTCOUNT(0)) & DWC3_GEVNTCOUNT_MASK;
+        if (setup && !dev->endpoints[USB_LEP_CTRL_IN].xfer_in_progress && !count) {
+            if (!quiet_deadline)
+                quiet_deadline = timeout_calculate(100000);
+            if (timeout_expired(quiet_deadline))
+                return 0;
+        } else {
+            quiet_deadline = 0;
+        }
+        udelay(100);
+    } while (!timeout_expired(deadline));
+    return -1;
+}
+
+static int usb_dwc3_wait_halted(dwc3_dev_t *dev, u32 timeout)
+{
+    u64 deadline = timeout_calculate(timeout);
+    do {
+        if (dev->failed || dev->dma_unsafe)
+            return -1;
+        if (read32(dev->regs + DWC3_DSTS) & DWC3_DSTS_DEVCTRLHLT)
+            return 0;
+        u32 count = read32(dev->regs + DWC3_GEVNTCOUNT(0)) & DWC3_GEVNTCOUNT_MASK;
+        if (count > DWC3_EVENT_BUFFERS_SIZE || count % sizeof(union dwc3_event))
+            return -1;
+        /* DWC3 cannot halt with unacknowledged events. shutting_down prevents
+         * event handling from restarting transfers or handling bus resets. */
+        if (count)
+            usb_dwc3_handle_events(dev);
+        udelay(1);
+    } while (!timeout_expired(deadline));
+    return -1;
+}
+#endif
+
