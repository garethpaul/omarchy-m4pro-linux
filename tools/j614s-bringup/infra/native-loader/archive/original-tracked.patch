+        goto unsafe;
+    }
+    NATIVE_USB_STEP(dev, "CONTROL_QUIET");
+#endif
@@ -1910,0 +1992,5 @@ bool usb_dwc3_shutdown(dwc3_dev_t *dev)
+#ifdef J614S_NATIVE
+        char phase[16];
