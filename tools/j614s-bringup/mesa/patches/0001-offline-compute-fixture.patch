diff --git a/src/gallium/drivers/asahi/README.apple9-compute-fixture.md b/src/gallium/drivers/asahi/README.apple9-compute-fixture.md
new file mode 100644
index 00000000000..2fa92549c20
--- /dev/null
+++ b/src/gallium/drivers/asahi/README.apple9-compute-fixture.md
@@ -0,0 +1,36 @@
+# Offline Apple9 first-compute fixture
+
+`agx_apple9_compute_fixture_tool --offline-template OUTPUT_PREFIX` compiles a
+new NIR shader that writes 42 to each of 256 output words. It writes the shader,
+entry image, resource record, launch program, direct CDM stream, reference output
+and exact compiler-profile JSON. It opens no render node and issues no ioctl.
+The virtual addresses in the JSON are unallocated template addresses.
+
+Build the tool and `agx_apple9_compute_fixture_tests` with `build-tests=true` on
+Linux. The normal Apple9 compiler, launcher and geometry tests remain applicable.
+The tool and tests link only reachable pure encoder sections from the same
+`agx_apple9.c` used by the runtime. The runtime device/model compatibility checks
+remain in force. In particular, this does not add G16S runtime support.
+
+The template builder calls the existing source encoders for the entry branch,
+launch, resource geometry and CDM record; it includes no recorded shader or
+firmware state. It supports one direct SSBO store profile with local size
+256x1x1 and no shared memory, preamble, scratch, atomics or samplers. Unsupported
+profiles fail without modifying the destination. The first entry occupies the
+ordinary 0x340 header plus one 0xc0 block. The CDM file includes the eight-byte
+terminator; the UAPI bound mirrors `agx_flush_compute` and includes its first
+four bytes.
+
+`agx_apple9_build_compute_fixture` takes explicit addresses and the complete
+shader byte length so a caller can
+rebuild the immutable records after allocating real VM mappings. A caller must
+validate the complete mappings, shader length, permissions, ownership, fences,
+CPU/GPU cache synchronization and output/page canaries before submission through
+the ordinary unchanged Asahi UAPI. Building a template does not qualify any of
+those runtime requirements. The 1-TiB USC placement follows this branch's G16
+path and remains untested on G16S.
+
+First hardware acceptance is a completed ordinary compute fence, exactly 256
+words equal to 42, unchanged surrounding canaries, no GPU faults or arbitrary
+page writes, and a repeat after a fresh qualified boot. No such G16S result is
+claimed by the tool or its host unit tests.
diff --git a/src/gallium/drivers/asahi/agx_apple9.c b/src/gallium/drivers/asahi/agx_apple9.c
index bd4d668ad01..cbace6e6d30 100644
--- a/src/gallium/drivers/asahi/agx_apple9.c
+++ b/src/gallium/drivers/asahi/agx_apple9.c
@@ -362,2 +362,2 @@ static bool apple9_build_body_entry(uint8_t *out, uint64_t entry,
-void
-agx_apple9_initialize_entries(struct agx_device *dev)
+static void
+apple9_initialize_entry_header(uint8_t *header)
@@ -365 +364,0 @@ agx_apple9_initialize_entries(struct agx_device *dev)
-   uint8_t *header = dev->apple9_entry_map;
@@ -371,0 +371,6 @@ agx_apple9_initialize_entries(struct agx_device *dev)
+}
+
+void
+agx_apple9_initialize_entries(struct agx_device *dev)
+{
+   apple9_initialize_entry_header(dev->apple9_entry_map);
@@ -781,0 +787,78 @@ apple9_build_body_entry(uint8_t *out, uint64_t entry, uint64_t body)
+static bool
+apple9_fixture_spans_overlap(uint64_t a, uint64_t a_size,
+                             uint64_t b, uint64_t b_size)
+{
+   return a < b + b_size && b < a + a_size;
+}
+
+/* Offline first-job template, using the same entry/launch/CDM encoders as
+ * the runtime. This neither selects a GPU profile nor submits any work. */
+bool
+agx_apple9_build_compute_fixture(
+   struct agx_apple9_compute_fixture *out,
+   const struct agx_apple9_compute_fixture_addresses *addresses,
+   const struct agx_apple9_compute_profile *profile)
+{
+   if (!out || !addresses || !profile ||
+       profile->abi != AGX_APPLE9_COMPUTE_ABI_DIRECT_BUFFERS ||
+       profile->resource_binding_count != 1 || profile->resource_binding[0] != 0 ||
+       profile->resource_kind[0] != AGX_APPLE9_COMPUTE_RESOURCE_SSBO ||
+       profile->resource_read_mask != 0 || profile->resource_write_mask != 1 ||
+       profile->variable_local_size || profile->local_size[0] != 256 ||
+       profile->local_size[1] != 1 || profile->local_size[2] != 1 ||
+       profile->preamble_size || profile->scratch_size ||
+       profile->required_threadgroup_memory_bytes || profile->atomic_frame_size ||
+       addresses->usc_base != (UINT64_C(1) << 40) ||
+       addresses->shader_body < addresses->usc_base + sizeof(out->entries) ||
+       addresses->shader_body - addresses->usc_base >= UINT64_C(0x100000000) ||
+       !addresses->shader_size ||
+       addresses->shader_size > addresses->usc_base + UINT64_C(0x100000000) - addresses->shader_body ||
+       (addresses->shader_body & 63) || (addresses->resource & 63) ||
+       (addresses->launch & 63) || (addresses->output & 3) ||
+       addresses->resource < addresses->usc_base + sizeof(out->entries) ||
+       addresses->resource > addresses->usc_base + UINT64_C(0x100000000) - sizeof(out->resources) ||
+       addresses->launch < addresses->usc_base + sizeof(out->entries) ||
+       addresses->launch > addresses->usc_base + UINT64_C(0x100000000) - sizeof(out->launch) ||
+       (addresses->resource < addresses->launch + sizeof(out->launch) &&
+        addresses->launch < addresses->resource + sizeof(out->resources)) ||
+       apple9_fixture_spans_overlap(addresses->shader_body, addresses->shader_size,
+                                    addresses->resource, sizeof(out->resources)) ||
+       apple9_fixture_spans_overlap(addresses->shader_body, addresses->shader_size,
+                                    addresses->launch, sizeof(out->launch)) ||
+       !addresses->output || addresses->output > (UINT64_C(1) << 42) - 1024 ||
+       (addresses->output < addresses->usc_base + UINT64_C(0x100000000) &&
+        addresses->usc_base < addresses->output + 1024))
+      return false;
+
+   _Alignas(8) struct agx_apple9_compute_fixture image = {0};
+   apple9_initialize_entry_header(image.entries);
+   const unsigned block = AGX_APPLE9_ENTRY_HEADER_SIZE;
+   const unsigned entry = block + AGX_APPLE9_ENTRY_CODE_OFFSET;
+   apple9_put_u32(image.entries + block, AGX_APPLE9_ENTRY_BLOCK_SIZE);
+   apple9_build_sentinel_constant_program(image.entries + block + 0x40, 30);
+   if (!apple9_build_body_entry(image.entries + entry,
+                                addresses->usc_base + entry,
+                                addresses->shader_body))
+      return false;
+
+   const struct agx_apple9_compute_geometry geometry = {
+      .mode = AGX_APPLE9_COMPUTE_GEOMETRY_DIRECT,
+      .threads = {256, 1, 1}, .local = {256, 1, 1},
+   };
+   if (!agx_apple9_build_compute_geometry_fields(
+          image.resources, sizeof(image.resources), addresses->resource,
+          &geometry))
+      return false;
+   apple9_put_u64(image.resources + 8, addresses->output);
+   if (!apple9_build_compute_launch(image.launch, addresses->usc_base,
+                                    addresses->launch, addresses->resource,
+                                    entry, profile, 0) ||
+       !agx_apple9_emit_direct_dispatch(image.cdm, addresses->launch,
+                                       geometry.threads, geometry.local, profile))
+      return false;
+   agx_pack(image.cdm + AGX_APPLE9_COMPUTE_CDM_RECORD_SIZE,
+            CDM_STREAM_TERMINATE, _) ;
+   *out = image;
+   return true;
+}
+
