diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
new file mode 100644
index 000000000..c73c91186
--- /dev/null
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0 OR MIT */
+/*
+ * Apple DockChannel HID transport: MTP interface power commands
+ */
+#ifndef _DOCKCHANNEL_HID_PROTOCOL_H
+#define _DOCKCHANNEL_HID_PROTOCOL_H
+
+#include <linux/string.h>
+#include <linux/types.h>
+
+/*
+ * Interface power commands go to the comm interface as SET_REPORT feature
+ * reports. Byte 0 is the command, byte 1 the power method, byte 2 the
+ * interface number and byte 3 the target power state.
+ *
+ * Power method 1 has nothing more. The coprocessor sequences the device
+ * itself and asks the host to pulse a reset line when it needs one.
+ *
+ * Power method 2 adds a has-changed flag in byte 4 and four bytes of
+ * padding. Each transition is announced with the flag clear, the host then
+ * drives the AFE reset line, and the transition is confirmed with the flag
+ * set. The J700 MTP firmware accepts only this nine-byte form.
+ */
+#define DCHID_CMD_RESET_INTERFACE	0x40
+
+#define DCHID_POWER_METHOD_1		1
+#define DCHID_POWER_METHOD_2		2
+
+#define DCHID_POWER_STATE_OFF		0
+#define DCHID_POWER_STATE_ON		2
+
+#define DCHID_PM1_CMD_SIZE		4
+#define DCHID_PM2_CMD_SIZE		9
+
+static inline void dchid_pm1_command(u8 iface, u8 state,
+				     u8 cmd[DCHID_PM1_CMD_SIZE])
+{
+	cmd[0] = DCHID_CMD_RESET_INTERFACE;
+	cmd[1] = DCHID_POWER_METHOD_1;
+	cmd[2] = iface;
+	cmd[3] = state;
+}
+
+static inline void dchid_pm2_command(u8 iface, u8 state, bool has_changed,
+				     u8 cmd[DCHID_PM2_CMD_SIZE])
+{
+	memset(cmd, 0, DCHID_PM2_CMD_SIZE);
+	cmd[0] = DCHID_CMD_RESET_INTERFACE;
+	cmd[1] = DCHID_POWER_METHOD_2;
+	cmd[2] = iface;
+	cmd[3] = state;
+	cmd[4] = has_changed;
+}
+
+#endif /* _DOCKCHANNEL_HID_PROTOCOL_H */
diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index df0aee80e..bf6ac4e1f 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -23,0 +24 @@
+#include "dockchannel-hid-protocol.h"
@@ -173,0 +175,3 @@ struct dchid_iface {
+	bool gpio_announced;
+	u32 power_method;
+	bool firmware_managed_reset;
@@ -192,0 +197,2 @@ struct dockchannel_hid {
+	bool j614s;
+	struct gpio_desc *afe_reset;
@@ -242,0 +249 @@ dchid_get_interface(struct dockchannel_hid *dchid, int index, const char *name)
+	iface->power_method = DCHID_POWER_METHOD_1;
@@ -262,0 +270,14 @@ dchid_get_interface(struct dockchannel_hid *dchid, int index, const char *name)
+	if (dchid->j614s) {
+		of_property_read_u32(iface->of_node, "apple,power-method", &iface->power_method);
+		iface->firmware_managed_reset =
+			of_property_read_bool(iface->of_node, "apple,firmware-managed-reset");
+		if ((iface->power_method != DCHID_POWER_METHOD_1 &&
+		     iface->power_method != DCHID_POWER_METHOD_2) ||
+		    (iface->power_method == DCHID_POWER_METHOD_2 && strcmp(name, "multi-touch")) ||
+		    (iface->firmware_managed_reset && iface->power_method != DCHID_POWER_METHOD_2)) {
+			of_node_put(iface->of_node);
+			destroy_workqueue(iface->wq);
+			return NULL;
+		}
+	}
+
@@ -404,0 +426,33 @@ static int dchid_reset_interface(struct dchid_iface *iface, int state)
+/*
+ * Power method 2: announce the transition, drive the AFE reset line to the
+ * new state and confirm the transition. The reset is asserted for a power-off
+ * and held for 50 ms, and released for a power-on.
+ */
+static int dchid_pm2_set_power(struct dchid_iface *iface, u8 state)
+{
+	struct dockchannel_hid *dchid = iface->dchid;
+	u8 msg[DCHID_PM2_CMD_SIZE];
+	int ret;
+
+	dchid_pm2_command(iface->index, state, false, msg);
+	ret = dchid_comm_cmd(dchid, msg, sizeof(msg));
+	if (ret < 0)
+		return ret;
+
+	if (iface->firmware_managed_reset) {
+		/* Firmware owns the reset; allow its power-on transition to settle. */
+		if (state == DCHID_POWER_STATE_ON)
+			fsleep(50 * USEC_PER_MSEC);
+	} else {
+		ret = gpiod_set_value_cansleep(dchid->afe_reset,
+					       state == DCHID_POWER_STATE_OFF);
+		if (ret < 0)
+			return ret;
+		if (state == DCHID_POWER_STATE_OFF)
+			fsleep(50 * USEC_PER_MSEC);
+	}
+
+	dchid_pm2_command(iface->index, state, true, msg);
+	return dchid_comm_cmd(dchid, msg, sizeof(msg));
+}
+
@@ -490,0 +545,5 @@ static int dchid_get_firmware(struct dchid_iface *iface, void **firmware, size_t
+	if (fw->size < sizeof(*hdr)) {
+		ret = -EINVAL;
+		goto done;
+	}
+
@@ -529,0 +589,8 @@ static int dchid_request_gpio(struct dchid_iface *iface)
+	if (iface->firmware_managed_reset)
+		return -EINVAL;
+	if (iface->dchid->j614s && iface->power_method == DCHID_POWER_METHOD_2 &&
+	    !strcmp(iface->gpio_name, "afe-reset")) {
+		iface->gpio = iface->dchid->afe_reset;
+		return iface->gpio ? 0 : -EINVAL;
+	}
+
@@ -551,2 +618,2 @@ static int dchid_start_interface(struct dchid_iface *iface)
-	void *fw;
-	size_t size;
+	void *fw = NULL;
+	size_t size = 0;
@@ -553,0 +621 @@ static int dchid_start_interface(struct dchid_iface *iface)
+	int step = 0;
@@ -562,0 +631 @@ static int dchid_start_interface(struct dchid_iface *iface)
+	step = 1;
@@ -567,0 +637 @@ static int dchid_start_interface(struct dchid_iface *iface)
+	step = 2;
@@ -573 +643,3 @@ static int dchid_start_interface(struct dchid_iface *iface)
-	if (!iface->dchid->use_ring && iface->gpio_id) {
+	if (!iface->dchid->use_ring && (iface->gpio_id ||
+	    (iface->dchid->j614s && iface->gpio_announced))) {
+		step = 3;
@@ -583,0 +656 @@ static int dchid_start_interface(struct dchid_iface *iface)
+		step = 4;
@@ -592,2 +665,12 @@ static int dchid_start_interface(struct dchid_iface *iface)
-		dchid_reset_interface(iface, 0);
-		dchid_reset_interface(iface, 2);
+		step = 5;
+		if (iface->dchid->j614s && iface->power_method == DCHID_POWER_METHOD_2) {
+			ret = dchid_pm2_set_power(iface, DCHID_POWER_STATE_OFF);
+			if (ret < 0)
+				goto err;
+			ret = dchid_pm2_set_power(iface, DCHID_POWER_STATE_ON);
+			if (ret < 0)
+				goto err;
+		} else {
+			dchid_reset_interface(iface, 0);
+			dchid_reset_interface(iface, 2);
+		}
@@ -598,0 +682,3 @@ static int dchid_start_interface(struct dchid_iface *iface)
+	if (iface->dchid->j614s)
+		dev_err(iface->dchid->dev, "J614s interface %s start step %d failed: %d (fw=%zu)\n",
+			iface->name, step, ret, size);
@@ -893,0 +980 @@ static void dchid_handle_init(struct dockchannel_hid *dchid, void *data, size_t
+			iface->gpio_announced = true;
@@ -1262,0 +1350,3 @@ static int dockchannel_hid_probe(struct platform_device *pdev)
+	dchid->j614s = of_machine_is_compatible("apple,j614s");
+	if (dchid->j614s && dchid->use_ring)
+		return dev_err_probe(dev, -EOPNOTSUPP, "J614s T8132 ring alias is unqualified\n");
@@ -1291,0 +1382,31 @@ static int dockchannel_hid_probe(struct platform_device *pdev)
+	if (dchid->j614s) {
+		/*
+		 * With power method 2 the host drives the multi-touch AFE reset line
+		 * during every power transition, so the line must be there before the
+		 * coprocessor announces the interface. Request it now, while a
+		 * -EPROBE_DEFER can still be honoured, and leave its level alone until
+		 * the first transition has been announced.
+		 */
+		child = of_get_child_by_name(dev->of_node, "multi-touch");
+		if (child) {
+			u32 power_method = DCHID_POWER_METHOD_1;
+			bool firmware_managed_reset;
+
+			of_property_read_u32(child, "apple,power-method", &power_method);
+			firmware_managed_reset =
+				of_property_read_bool(child, "apple,firmware-managed-reset");
+			of_node_put(child);
+			if (firmware_managed_reset &&
+			    (power_method != DCHID_POWER_METHOD_2 ||
+			     of_property_present(dev->of_node, "apple,afe-reset-gpios")))
+				return dev_err_probe(dev, -EINVAL, "Conflicting touch reset ownership\n");
+			if (power_method == DCHID_POWER_METHOD_2 && !firmware_managed_reset) {
+				dchid->afe_reset = devm_gpiod_get(dev, "apple,afe-reset",
+								  GPIOD_ASIS);
+				if (IS_ERR(dchid->afe_reset))
+					return dev_err_probe(dev, PTR_ERR(dchid->afe_reset),
+							     "Failed to request the AFE reset line\n");
+			}
+		}
+	}
+
