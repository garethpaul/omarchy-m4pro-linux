From c44269c508e7803cedf16b62056d27bc34060f95 Mon Sep 17 00:00:00 2001
From: gareth jones <gareth@garethpaul.com>
Date: Mon, 19 Oct 2026 22:35:44 -0700
Subject: [PATCH 1/4] arm64: port qualified M4 wait-state preservation to
 Gravity

Reuse the tested 1d78f77f8052 J614s behavior and its existing idle-apple assembly foundation without idle=nop or maxcpus limits. Keep Gravity's existing Donan CPU constants. Source port only; this Gravity candidate has not run on hardware.
---
 arch/arm64/include/asm/apple-idle.h   |  8 +++++
 arch/arm64/include/asm/cputype.h      |  7 ++++
 arch/arm64/kernel/Makefile            |  2 ++
 arch/arm64/kernel/idle-apple.S        | 45 +++++++++++++++++++++++++
 arch/arm64/kernel/idle.c              | 48 +++++++++++++++++++++++++--
 arch/arm64/kernel/pi/idreg-override.c |  7 ++++
 6 files changed, 115 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm64/include/asm/apple-idle.h
 create mode 100644 arch/arm64/kernel/idle-apple.S

diff --git a/arch/arm64/include/asm/apple-idle.h b/arch/arm64/include/asm/apple-idle.h
new file mode 100644
index 000000000..c3b72f957
--- /dev/null
+++ b/arch/arm64/include/asm/apple-idle.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_APPLE_IDLE_H
+#define __ASM_APPLE_IDLE_H
+
+/* WFI that preserves x18-x30 on affected Apple cores. */
+void apple_cpu_wfi(void);
+
+#endif
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index eedf0af4c..790fccf28 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -277,0 +278,7 @@ static inline u32 __attribute_const__ read_cpuid_id(void)
+/* Apple part numbers from Donan onward identify M4 and later cores. */
+static inline bool midr_is_apple_m4_or_later(u32 midr)
+{
+	return MIDR_IMPLEMENTOR(midr) == ARM_CPU_IMP_APPLE &&
+	       MIDR_PARTNUM(midr) >= APPLE_CPU_PART_M4_DONAN_ECORE;
+}
+
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index 81df89483..2db39f6e1 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -39,0 +40,2 @@ obj-y			:= debug-monitors.o entry.o irq.o fpsimd.o		\
+obj-$(CONFIG_ARCH_APPLE)	+= idle-apple.o
+
diff --git a/arch/arm64/kernel/idle-apple.S b/arch/arm64/kernel/idle-apple.S
new file mode 100644
index 000000000..4f31e8410
--- /dev/null
+++ b/arch/arm64/kernel/idle-apple.S
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+/*
+ * Affected Apple cores can resume from WFI with cleared general registers.
+ * SP and stack memory survive. Preserve the AAPCS64 callee-saved registers
+ * and x18 (which may hold the shadow call stack), including the return PC.
+ * This follows the stateless-wait approach used during m1n1 M5 Windows
+ * bring-up. It does not configure an Apple deep-sleep state or DVFS policy.
+ *
+ * IRQ masking/context management remains with cpu_do_idle(). The direct
+ * function call tells its compiler that x0-x17 and flags are clobbered.
+ */
+	.macro apple_wait_save
+	stp	x29, x30, [sp, #-112]!
+	mov	x29, sp
+	stp	x19, x20, [sp, #16]
+	stp	x21, x22, [sp, #32]
+	stp	x23, x24, [sp, #48]
+	stp	x25, x26, [sp, #64]
+	stp	x27, x28, [sp, #80]
+	str	x18, [sp, #96]
+	dsb	sy
+	.endm
+
+	.macro apple_wait_restore
+	isb
+	ldr	x18, [sp, #96]
+	ldp	x19, x20, [sp, #16]
+	ldp	x21, x22, [sp, #32]
+	ldp	x23, x24, [sp, #48]
+	ldp	x25, x26, [sp, #64]
+	ldp	x27, x28, [sp, #80]
+	ldp	x29, x30, [sp], #112
+	ret
+	.endm
+
+	.pushsection .cpuidle.text, "ax"
+SYM_FUNC_START(apple_cpu_wfi)
+	apple_wait_save
+	wfi
+	apple_wait_restore
+SYM_FUNC_END(apple_cpu_wfi)
+	.popsection
diff --git a/arch/arm64/kernel/idle.c b/arch/arm64/kernel/idle.c
index 42c5543f9..f63255103 100644
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -6,0 +7 @@
+#include <linux/init.h>
@@ -7,0 +9 @@
+#include <linux/jump_label.h>
@@ -8,0 +11 @@
+#include <asm/apple-idle.h>
@@ -11,0 +15,2 @@
+#include <asm/cputype.h>
+#include <asm/fpsimd.h>
@@ -36,0 +42,29 @@ early_param("idle", setup_idle);
+#ifdef CONFIG_ARCH_APPLE
+/*
+ * Preserve general-purpose and FP/SIMD state across WFI on M4 and later
+ * Apple cores. The key is enabled once at boot; elsewhere the check is a
+ * patched-out branch.
+ */
+static DEFINE_STATIC_KEY_FALSE(apple_wfi_loses_regs);
+
+static int __init apple_wfi_quirk_init(void)
+{
+	if (midr_is_apple_m4_or_later(read_cpuid_id())) {
+		static_branch_enable(&apple_wfi_loses_regs);
+		pr_info("Apple: preserving registers across WFI\n");
+	}
+	return 0;
+}
+early_initcall(apple_wfi_quirk_init);
+
+static __always_inline bool apple_wfi_needs_save(void)
+{
+	return static_branch_unlikely(&apple_wfi_loses_regs);
+}
+#else
+static __always_inline bool apple_wfi_needs_save(void)
+{
+	return false;
+}
+#endif
+
@@ -53,2 +87,12 @@ void __cpuidle cpu_do_idle(void)
-		dsb(sy);
-		wfi();
+		if (apple_wfi_needs_save()) {
+			/*
+			 * The FP/SIMD registers do not survive either: drop the
+			 * lazy ownership so the next return to userspace reloads
+			 * them, even when the same task resumes on this CPU.
+			 */
+			fpsimd_save_and_flush_cpu_state();
+			apple_cpu_wfi();
+		} else {
+			dsb(sy);
+			wfi();
+		}
diff --git a/arch/arm64/kernel/pi/idreg-override.c b/arch/arm64/kernel/pi/idreg-override.c
index d4e0b2c6f..d06af49e9 100644
--- a/arch/arm64/kernel/pi/idreg-override.c
+++ b/arch/arm64/kernel/pi/idreg-override.c
@@ -14,0 +15 @@
+#include <asm/cputype.h>
@@ -415,0 +417,6 @@ void __init init_feature_override(u64 boot_status, const void *fdt,
+	/* Timed waits bypass the register-saving idle path on Apple M4+ cores.
+	 * Apply after boot arguments so they cannot re-enable WFxT.
+	 */
+	if (IS_ENABLED(CONFIG_ARCH_APPLE) && midr_is_apple_m4_or_later(read_cpuid_id()))
+		__parse_cmdline("id_aa64isar2.wfxt=0", false);
+
