From dd3f608d60ed503b87a9400255286d1c8fe5ac2d Mon Sep 17 00:00:00 2001
From: gareth jones <gareth@garethpaul.com>
Date: Mon, 19 Oct 2026 23:18:23 -0700
Subject: [PATCH] nvme: port FUA flush-emulation core quirk required by
 inherited ANS

---
 drivers/nvme/host/core.c | 2 ++
 drivers/nvme/host/nvme.h | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index d6a8aac8e..9e810008e 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -2434,0 +2435,2 @@ static int nvme_update_ns_info_block(struct nvme_ns *ns,
+	if (ns->ctrl->quirks & NVME_QUIRK_BROKEN_FUA)
+		lim.features &= ~BLK_FEAT_FUA;
diff --git a/drivers/nvme/host/nvme.h b/drivers/nvme/host/nvme.h
index 4732c4c5c..ceb1bfe51 100644
--- a/drivers/nvme/host/nvme.h
+++ b/drivers/nvme/host/nvme.h
@@ -185,0 +186,5 @@ enum nvme_quirks {
+
+	/*
+	 * Emulate Force Unit Access with explicit flush commands.
+	 */
+	NVME_QUIRK_BROKEN_FUA			= (1 << 24),
@@ -238,0 +244,2 @@ static inline char *nvme_quirk_name(enum nvme_quirks q)
+	case NVME_QUIRK_BROKEN_FUA:
+		return "broken_fua";
