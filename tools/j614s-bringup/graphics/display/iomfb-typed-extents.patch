+++ b/drivers/gpu/drm/apple/iomfb_internal.h
@@ -58,0 +59,6 @@ typedef void (*dcp_callback_t)(struct apple_dcp *, void *, void *);
+/* Keep access bounds next to the typed wrapper, so changing a C type also
+ * changes its callback contract. Zero input means opaque/unconsumed input.
+ */
+#define DCP_CB_SIZE(func, in_size, out_size) \
+	enum { func ## _in_size = (in_size), func ## _out_size = (out_size) }
+
@@ -59,0 +66 @@ typedef void (*dcp_callback_t)(struct apple_dcp *, void *, void *);
+	DCP_CB_SIZE(func, 0, 0);                                              \
@@ -67,0 +75 @@ typedef void (*dcp_callback_t)(struct apple_dcp *, void *, void *);
+	DCP_CB_SIZE(func, sizeof(T_in), 0);                                   \
@@ -79,0 +88 @@ typedef void (*dcp_callback_t)(struct apple_dcp *, void *, void *);
+	DCP_CB_SIZE(func, sizeof(T_in), sizeof(T_out));                       \
@@ -92,0 +102 @@ typedef void (*dcp_callback_t)(struct apple_dcp *, void *, void *);
+	DCP_CB_SIZE(func, 0, sizeof(T_out));                                  \
