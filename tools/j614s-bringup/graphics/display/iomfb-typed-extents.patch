diff --git a/drivers/gpu/drm/apple/iomfb.h b/drivers/gpu/drm/apple/iomfb.h
index c97a1ab..a386796 100644
--- a/drivers/gpu/drm/apple/iomfb.h
+++ b/drivers/gpu/drm/apple/iomfb.h
@@ -182,0 +183,7 @@ typedef bool (*iomfb_cb_handler)(struct apple_dcp *, int, void *, void *);
+/* Minimum extents accessed by this handler, not a complete wire ABI schema. */
+struct iomfb_cb_contract {
+	iomfb_cb_handler handler;
+	u32 min_in;
+	u32 min_out;
+};
+
diff --git a/drivers/gpu/drm/apple/iomfb_internal.h b/drivers/gpu/drm/apple/iomfb_internal.h
